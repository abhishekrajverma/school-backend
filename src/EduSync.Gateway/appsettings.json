{
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "api-v1": {
        "ClusterId": "api",
        "Match": { "Path": "/api/v1/{**catch-all}" }
      },
      "hubs": {
        "ClusterId": "api",
        "Match": { "Path": "/hubs/{**catch-all}" }
      },
      "hangfire": {
        "ClusterId": "api",
        "Match": { "Path": "/hangfire/{**catch-all}" }
      },
      "swagger": {
        "ClusterId": "api",
        "Match": { "Path": "/swagger/{**catch-all}" }
      },
      "graphql": {
        "ClusterId": "api",
        "Match": { "Path": "/graphql{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5000/" }
        }
      }
    }
  }
}
