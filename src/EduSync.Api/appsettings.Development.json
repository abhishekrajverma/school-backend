{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=EduSync;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True;Encrypt=False;Min Pool Size=10;Max Pool Size=200",
    "ReadConnection": ""
  },
  "Capacity": {
    "TargetSchools": 200,
    "MaxConcurrentUsersPerSchool": 300,
    "ParentDailyActivePerSchool": 500,
    "SingleDatabase": true
  },
  "Jwt": {
    "Key": "EduSync_Dev_Signing_Key_Change_In_Production_32+"
  },
  "FinancialYear": {
    "DefaultYear": "2024-25"
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173"
    ]
  },
  "Uploads": {
    "Provider": "Local",
    "RootPath": "uploads",
    "MaxBytes": 10485760
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "TenantCacheMinutes": 10,
    "DashboardCacheSeconds": 60,
    "RateLimitPerMinute": 8000
  },
  "Database": {
    "UseReadReplica": false,
    "CommandTimeoutSeconds": 30
  },
  "SignalR": {
    "Enabled": true
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5
  },
  "MultiRegion": {
    "CurrentRegion": "ap-south-1",
    "AllowedRegions": [ "ap-south-1", "us-east-1", "eu-west-1" ],
    "RequireRegionHeader": false
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "EduSync.Api",
    "OtlpEndpoint": ""
  },
  "Audit": {
    "Enabled": true,
    "LogGetRequests": false
  },
  "Chaos": {
    "Enabled": false,
    "FailureRate": 0.05,
    "MaxLatencyMs": 200,
    "AllowInProduction": false
  },
  "Oidc": {
    "Enabled": false,
    "Authority": "https://login.microsoftonline.com/{tenant-id}/v2.0",
    "ClientId": "your-app-client-id",
    "Scopes": "openid profile email"
  },
  "Encryption": {
    "Enabled": false,
    "DataKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "Retention": {
    "Enabled": true,
    "RunIntervalHours": 24,
    "DefaultAuditLogDays": 365,
    "DefaultOutboxDays": 90,
    "DefaultWebhookDeliveryDays": 30
  },
  "GraphQL": {
    "Enabled": true
  },
  "ScheduledJobs": {
    "Enabled": true,
    "FeeReminderIntervalHours": 24,
    "UseHangfire": true
  }
}
