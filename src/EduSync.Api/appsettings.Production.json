{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_HOST;Database=EduSync;User Id=edusync_app;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True;Min Pool Size=50;Max Pool Size=500;Connect Timeout=30"
  },
  "Capacity": {
    "TargetSchools": 10,
    "MaxConcurrentUsersPerSchool": 200,
    "ParentDailyActivePerSchool": 300,
    "SingleDatabase": true
  },
  "Database": {
    "UseReadReplica": false,
    "CommandTimeoutSeconds": 30
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "YOUR_REDIS:6379",
    "TenantCacheMinutes": 15,
    "DashboardCacheSeconds": 90,
    "RateLimitPerMinute": 8000
  },
  "ScheduledJobs": {
    "Enabled": true,
    "UseHangfire": true
  },
  "SignalR": {
    "Enabled": true
  }
}
